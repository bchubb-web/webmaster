{
    "name": "bchubb-web/webmaster",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Webmaster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webmaster\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Billy Chubb",
            "email": "billy@bchubb.co.uk"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "twig/twig": "^3",
        "symfony/routing": "^8.0",
        "league/container": "^4.0",
        "league/config": "^1.2",
        "monolog/monolog": "^3.9",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "predis/predis": "^3.2",
        "relay/relay": "^3.0",
        "psr/http-server-handler": "^1.0",
        "middlewares/debugbar": "^2.2",

        "symfony/event-dispatcher": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/yaml": "^8.0",
        "symfony/cache": "^8.0",

        "symfony/twig-bundle": "^8.0",
        "symfony/twig-bridge": "^8.0",

        "symfony/web-profiler-bundle": "^8.0",

        "symfony/form": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/translation": "^8.0",


        "symfony/ux-twig-component": "^3.0",

        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/dbal": "^4.3",
        "doctrine/orm": "^3.5",

        "league/flysystem": "^3.30",
        "opis/closure": "^4.3",
        "easycorp/easyadmin-bundle": "^5.0"
    },
    "require-dev": {
        "php-debugbar/php-debugbar": "^2.2",
        "phpunit/phpunit": "^12.4"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bchubb-web/webmaster-doctrine.git"
        }
    ],
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
